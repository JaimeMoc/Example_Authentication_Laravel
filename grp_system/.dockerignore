# Dependencias (se instalan dentro del contenedor)
node_modules/
vendor/

# Assets compilados (se generan en el build)
public/build/
public/hot/

# Variables de entorno
.env
.env.*
!.env.example
!.env.docker

# Archivos de desarrollo
.git/
.github/
.vscode/
.idea/
.fleet/
.nova/
.zed/

# Logs y cache local
storage/logs/*.log
storage/framework/cache/
storage/framework/sessions/
storage/framework/views/
bootstrap/cache/*.php

# Tests
tests/
phpunit.xml
.phpunit.cache/
.phpunit.result.cache

# Herramientas de desarrollo
Dockerfile
docker-compose*.yml
*.md
