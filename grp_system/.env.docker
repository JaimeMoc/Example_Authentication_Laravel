# Copia este archivo como .env antes de usar docker-compose
# cp .env.docker .env

APP_NAME="GRP System"
APP_ENV=production
APP_KEY=                        # Genera con: php artisan key:generate --show
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=error

# ── Base de datos ────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=db                      # Nombre del servicio en docker-compose
DB_PORT=3306
DB_DATABASE=grp_system
DB_USERNAME=grp_user
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret

# ── Cache / Session / Queue ──────────────────────────────────────────────────
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database

# ── Email ────────────────────────────────────────────────────────────────────
# Para desarrollo usa Mailpit (incluido en docker-compose):
MAIL_MAILER=smtp
MAIL_HOST=mail                  # Nombre del servicio en docker-compose
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@grpsystem.com"
MAIL_FROM_NAME="GRP System"

# ── Microsoft SSO (opcional) ─────────────────────────────────────────────────
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:8000/auth/microsoft2/callback

VITE_APP_NAME="${APP_NAME}"
